# Environment Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME="Olivet Academic Records Platform"
APP_URL=http://localhost:8000

# Security & Secrets
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
JWT_PRIVATE_KEY_PATH=config/keys/jwt_rs256.key
JWT_PUBLIC_KEY_PATH=config/keys/jwt_rs256.pub
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16)
# POSTGRES_USER is the bootstrap/admin role used only for migrations.
POSTGRES_USER=olivet_app
POSTGRES_PASSWORD=olivet_secure_pass
# Runtime role: must be NOSUPERUSER/NOBYPASSRLS so Row-Level Security applies.
APP_POSTGRES_USER=olivet_runtime
APP_POSTGRES_PASSWORD=olivet_runtime_secure_pass
POSTGRES_DB=olivet_records
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://olivet_runtime:olivet_runtime_secure_pass@localhost:5432/olivet_records
MIGRATION_DATABASE_URL=postgresql+asyncpg://olivet_app:olivet_secure_pass@localhost:5432/olivet_records
DATABASE_SYNC_URL=postgresql://olivet_app:olivet_secure_pass@localhost:5432/olivet_records

# Connection pool. Keep small when behind a managed transaction pooler.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
# 0 is safest through Neon's -pooler/PgBouncer endpoint. Leave unset to
# auto-detect (-pooler -> 0, direct -> 100).
# DB_PREPARED_STATEMENT_CACHE_SIZE=0
# Optional driver-level TLS mode; URLs may also use ?ssl=require.
# DB_SSL_MODE=require

# --- Managed Postgres (Neon) example ---
# Create the runtime role with SQL, not the Console/API: Console/API roles
# inherit neon_superuser, which includes BYPASSRLS and ignores RLS.
# Use the pooled URL for the app and the direct URL (no -pooler) for Alembic.
# DATABASE_URL=postgresql+asyncpg://olivet_runtime:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?ssl=require
# MIGRATION_DATABASE_URL=postgresql+asyncpg://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?ssl=require

# Redis Broker & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_SSL_CERT_REQS=required
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=20

# --- Managed Redis (Upstash) example ---
# REDIS_URL=rediss://default:TOKEN@host.upstash.io:6379?ssl_cert_reqs=required
# REDIS_BROKER_URL=rediss://default:TOKEN@host.upstash.io:6379?ssl_cert_reqs=required
# CELERY_RESULT_BACKEND=rediss://default:TOKEN@host.upstash.io:6379?ssl_cert_reqs=required

# Email Delivery (Mailgun / SMTP)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
DEFAULT_FROM_EMAIL="Olivet Baptist High School <records@olivet.edu.ng>"

# Asset Storage (M8 branding uploads)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=var/storage
# Optional public URL prefix when assets are served by a reverse proxy/CDN.
# STORAGE_PUBLIC_BASE_URL=https://files.example.com
BRANDING_UPLOAD_MAX_BYTES=2097152

# Rate Limiting
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1
